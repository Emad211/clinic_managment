{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic.example.ir/schemas/clinical-engine-v2/evaluation-result.schema.json",
  "title": "Clinical Engine v2 Evaluation Result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "patient_link_id",
    "as_of_at",
    "engine_version",
    "ruleset",
    "fact_snapshot",
    "run_status",
    "rule_results",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "patient_link_id": {
      "type": "integer",
      "minimum": 1
    },
    "encounter_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "as_of_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "type": "string"
    },
    "ruleset": {
      "type": "object",
      "required": [
        "ruleset_code",
        "version",
        "content_hash"
      ],
      "properties": {
        "ruleset_code": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fact_snapshot": {
      "type": "object",
      "required": [
        "snapshot_hash",
        "facts"
      ],
      "properties": {
        "snapshot_hash": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "clinical-fact.schema.json"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "run_status": {
      "enum": [
        "COMPLETED",
        "COMPLETED_WITH_ERRORS",
        "SAFETY_FAILED",
        "FACT_BUILD_FAILED",
        "RULESET_INVALID"
      ]
    },
    "rule_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_code",
          "rule_version",
          "phase",
          "predicate_state",
          "outcome",
          "trace",
          "data_issues",
          "recommendations"
        ],
        "properties": {
          "rule_code": {
            "type": "string"
          },
          "rule_version": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "PREFLIGHT",
              "SAFETY",
              "ROUTINE"
            ]
          },
          "predicate_state": {
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN",
              "ERROR"
            ]
          },
          "outcome": {
            "enum": [
              "FIRED",
              "NOT_FIRED",
              "NEEDS_DATA",
              "NOT_APPLICABLE",
              "SUPPRESSED",
              "ERROR"
            ]
          },
          "trace": {
            "$ref": "#/$defs/trace_node"
          },
          "data_issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_key",
                "issue"
              ],
              "properties": {
                "fact_key": {
                  "type": "string"
                },
                "issue": {
                  "enum": [
                    "MISSING",
                    "UNKNOWN",
                    "NOT_ASKED",
                    "STALE",
                    "UNVERIFIED",
                    "CONFLICTING",
                    "UNIT_MISMATCH",
                    "INVALID_TYPE",
                    "SOURCE_UNAVAILABLE"
                  ]
                },
                "message_fa": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "suppression": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "reason_code": {
                "type": "string"
              },
              "message_fa": {
                "type": "string"
              },
              "caused_by_rule_code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "reason_code",
              "message_fa"
            ],
            "additionalProperties": false
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "recommendation_key",
                "action_type",
                "text_fa",
                "suggestion_only",
                "requires_clinician_confirmation",
                "presentation"
              ],
              "properties": {
                "recommendation_key": {
                  "type": "string"
                },
                "action_type": {
                  "type": "string"
                },
                "text_fa": {
                  "type": "string"
                },
                "suggestion_only": {
                  "const": true
                },
                "requires_clinician_confirmation": {
                  "type": "boolean"
                },
                "presentation": {
                  "enum": [
                    "INTERRUPTIVE",
                    "PROMINENT",
                    "NON_INTERRUPTIVE",
                    "HIDDEN"
                  ]
                },
                "may_create_internal_task": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "redflag_active",
        "routine_outputs_blocked",
        "counts",
        "data_sufficiency",
        "data_quality"
      ],
      "properties": {
        "redflag_active": {
          "type": "boolean"
        },
        "routine_outputs_blocked": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "data_sufficiency": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "INSUFFICIENT"
          ]
        },
        "data_quality": {
          "enum": [
            "VERIFIED",
            "MIXED",
            "STALE",
            "CONFLICTING",
            "UNVERIFIED",
            "UNKNOWN"
          ]
        },
        "applicability": {
          "enum": [
            "EXACT",
            "PARTIAL",
            "UNCERTAIN",
            "NOT_APPLICABLE"
          ]
        },
        "confidence_warning_fa": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "trace_node": {
      "type": "object",
      "required": [
        "node_id",
        "kind",
        "state",
        "message_fa"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "ALL",
            "ANY",
            "NOT",
            "PREDICATE",
            "ELIGIBILITY",
            "REQUIRED_FACT",
            "SAFETY"
          ]
        },
        "state": {
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN",
            "ERROR"
          ]
        },
        "message_fa": {
          "type": "string"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actual": {},
        "expected": {},
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_node"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
