# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (the locked target stack). The DB role MUST NOT have BYPASSRLS,
# otherwise tenant isolation (RLS) is bypassed.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/clinic_platform

# Knowledge pipeline (ai_service) base URL — enables ICD-11 crosswalk enrichment
# on the patient page. Leave unset to disable (the UI degrades gracefully).
AI_SERVICE_URL=
