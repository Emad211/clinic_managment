+    # Blueprint lifecycle state cannot skip it.
+    db.commit()
+    from src.adapters.sqlite.clinical_engine_v1_cutover import (
+        ensure_v1_schema_cutover,
+    )
+
+    ensure_v1_schema_cutover(db)
