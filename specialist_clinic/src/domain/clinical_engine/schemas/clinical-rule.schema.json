{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic.local/schemas/clinical-engine-v2/clinical-rule.schema.json",
  "title": "Clinical Engine v2 Rule",
  "type": "object",
  "required": ["schema_version", "dsl_version", "rule_code", "version", "title", "phase", "action_type", "severity", "priority", "scope", "required_facts", "eligibility", "condition", "safety", "recommendation", "evidence", "governance"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "dsl_version": {"const": "2.0"},
    "rule_code": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "title": {"type": "string", "minLength": 1},
    "phase": {"enum": ["PREFLIGHT", "SAFETY", "ROUTINE"]},
    "action_type": {"enum": ["redflag", "safety_alert", "suggest_med", "flag_risk", "set_target", "classify", "create_followup", "schedule_screening", "vaccine", "educate"]},
    "severity": {"enum": ["INFO", "WARN", "URGENT", "CRITICAL"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
    "semantic_key": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["population", "care_settings", "encounter_types"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "age_min": {"type": ["number", "null"], "minimum": 0},
        "age_max": {"type": ["number", "null"], "minimum": 0},
        "sex": {"type": "array", "items": {"enum": ["female", "male", "intersex", "unknown", "any"]}, "uniqueItems": true},
        "care_settings": {"type": "array", "minItems": 1, "items": {"enum": ["outpatient", "primary_care", "specialty_clinic", "urgent_care"]}, "uniqueItems": true},
        "encounter_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "condition_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "out_of_scope": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "required_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "criticality", "on_unusable"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "criticality": {"enum": ["CRITICAL", "REQUIRED", "OPTIONAL"]},
          "max_age_days": {"type": ["integer", "null"], "minimum": 0},
          "minimum_verification": {"enum": ["CONFIRMED", "PROVISIONAL", "UNVERIFIED"]},
          "on_unusable": {"enum": ["NEEDS_DATA", "NOT_APPLICABLE", "CONTINUE_WITH_WARNING"]},
          "prompt_fa": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "eligibility": {"$ref": "#/$defs/expression"},
    "condition": {"$ref": "#/$defs/expression"},
    "safety": {
      "type": "object",
      "required": ["redflag_exclusions", "hard_exclusions", "on_safety_error"],
      "properties": {
        "redflag_exclusions": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
        "hard_exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["exclusion_id", "condition", "effect", "message_fa"],
            "properties": {
              "exclusion_id": {"type": "string", "minLength": 1},
              "condition": {"$ref": "#/$defs/expression"},
              "effect": {"enum": ["SUPPRESS", "BLOCK_ACTION", "REQUIRE_OVERRIDE"]},
              "message_fa": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "on_safety_error": {"const": "BLOCK_ROUTINE_OUTPUTS"}
      },
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "required": ["text_fa", "suggestion_only", "requires_clinician_confirmation", "may_create_internal_task"],
      "properties": {
        "text_fa": {"type": "string", "minLength": 1},
        "suggestion_only": {"const": true},
        "requires_clinician_confirmation": {"type": "boolean"},
        "may_create_internal_task": {"type": "boolean"},
        "params": {"$ref": "#/$defs/recommendationParams"},
        "explanation_template_fa": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_title", "issuing_organization", "source_version", "source_locator", "source_url", "evidence_certainty", "recommendation_strength", "local_validation_status"],
      "properties": {
        "source_title": {"type": "string", "minLength": 1},
        "issuing_organization": {"type": "string", "minLength": 1},
        "publication_date": {"type": ["string", "null"], "format": "date"},
        "source_version": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "evidence_certainty": {"enum": ["HIGH", "MODERATE", "LOW", "VERY_LOW", "NOT_GRADED", "LEGACY_ADA_A", "LEGACY_ADA_B", "LEGACY_ADA_C", "LEGACY_ADA_E"]},
        "recommendation_strength": {"enum": ["STRONG_FOR", "CONDITIONAL_FOR", "STRONG_AGAINST", "CONDITIONAL_AGAINST", "NOT_GRADED"]},
        "local_validation_status": {"enum": ["NOT_REVIEWED", "CLINICALLY_REVIEWED", "APPROVED_FOR_SHADOW", "APPROVED_FOR_ACTIVE"]},
        "local_adaptation_note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": ["status", "author", "clinical_reviewer", "review_due_date"],
      "properties": {
        "status": {"enum": ["DRAFT", "VALIDATED", "APPROVED", "SILENT", "ACTIVE", "SUSPENDED", "RETIRED"]},
        "author": {"type": "string", "minLength": 1},
        "clinical_reviewer": {"type": ["string", "null"]},
        "technical_reviewer": {"type": ["string", "null"]},
        "review_due_date": {"type": "string", "format": "date"},
        "supersedes": {"type": ["string", "null"]},
        "change_note": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "recommendationParams": {
      "type": "object",
      "properties": {
        "due_in_hours": {"type": "integer", "minimum": 0, "maximum": 8760},
        "due_in_days": {"type": "integer", "minimum": 0, "maximum": 3650},
        "due_period": {"type": "string", "minLength": 1, "maxLength": 120},
        "task_contract": {
          "type": "object",
          "required": ["allowed_outcome_types", "minimum_verification", "canonical_ingestion"],
          "properties": {
            "urgency": {"enum": ["ROUTINE", "PRIORITY", "URGENT", "CRITICAL"]},
            "allowed_outcome_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["OBSERVATION", "PATIENT_REPORTED", "ENCOUNTER_COMPLETED", "PROCEDURE_COMPLETED", "LAB_COMPLETED", "OTHER"]}
            },
            "required_fact_keys": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^(observation|lab)\\.[a-z0-9][a-z0-9._-]*$"}
            },
            "minimum_verification": {"enum": ["CONFIRMED", "PROVISIONAL", "UNVERIFIED"]},
            "canonical_ingestion": {"enum": ["NONE", "OPTIONAL", "REQUIRED"]},
            "requires_acknowledgement": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "do_not_auto_refer": {"type": "boolean"},
        "do_not_auto_message": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "expression": {
      "oneOf": [
        {"type": "object", "required": ["node_id", "all"], "properties": {"node_id": {"type": "string", "minLength": 1}, "all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}, "additionalProperties": false},
        {"type": "object", "required": ["node_id", "any"], "properties": {"node_id": {"type": "string", "minLength": 1}, "any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}, "additionalProperties": false},
        {"type": "object", "required": ["node_id", "not"], "properties": {"node_id": {"type": "string", "minLength": 1}, "not": {"$ref": "#/$defs/expression"}}, "additionalProperties": false},
        {
          "type": "object",
          "required": ["node_id", "fact", "op"],
          "properties": {
            "node_id": {"type": "string", "minLength": 1},
            "fact": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "selector": {
              "type": "object",
              "properties": {
                "aggregation": {"enum": ["single", "latest", "all", "count", "within_days", "count_within_days", "recently_completed"]},
                "within_days": {"type": "integer", "minimum": 0},
                "minimum_count": {"type": "integer", "minimum": 1},
                "allow_stale": {"type": "boolean"},
                "allow_unverified": {"type": "boolean"},
                "allow_conflicting": {"type": "boolean"}
              },
              "additionalProperties": false
            },
            "op": {"enum": ["has", "not_has", "in", "truthy", "exists", "==", "!=", "between", ">=", "<=", ">", "<"]},
            "value": {},
            "unit": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
