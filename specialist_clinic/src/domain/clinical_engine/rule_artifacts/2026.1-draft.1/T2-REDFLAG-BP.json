  "title": "هشدار فوری فشار خون بسیار بالا در بیمار دیابتی",
  "legacy_rule_id": null,
  "phase": "PREFLIGHT",
  "action_type": "redflag",
  "severity": "CRITICAL",
  "priority": 1,
  "semantic_key": "diabetes:redflag:severe-blood-pressure",
