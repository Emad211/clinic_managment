    {"key": "observation.bp_diastolic", "criticality": "OPTIONAL", "max_age_days": 1, "minimum_verification": "PROVISIONAL", "on_unusable": "CONTINUE_WITH_WARNING", "prompt_fa": "فشار دیاستولیک تازه را ثبت کنید."}
