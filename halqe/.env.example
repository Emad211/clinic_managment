# halqe — Environment Variables Reference
# Copy this file to .env (which is git-ignored) and fill in your values.
# .env is NOT committed to git. Never commit real secrets.
#
# ---------------------------------------------------------------------------
# PRODUCTION FLAG (required in real deploys — leave UNSET for dev/CI/tests)
# ---------------------------------------------------------------------------

# Set to 1 to enable all production hardening (fail-fast guards on SECRET_KEY,
# DEBUG forced off, ALLOWED_HOSTS wildcard rejected, CORS from env not localhost).
# Do NOT set this in dev, CI, or test environments.
# PRODUCTION=1

# ---------------------------------------------------------------------------
# SECURITY (required in production when PRODUCTION=1)
# ---------------------------------------------------------------------------

# Strong unique secret key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# REQUIRED in production; a dev placeholder is used automatically otherwise.
SECRET_KEY=halqe-dev-secret-not-for-production

# Debug mode. Default is true in dev. Production forces this to False
# regardless of this value (when PRODUCTION=1).
DEBUG=true

# Comma-separated list of allowed host names. REQUIRED in production.
# Wildcards (*) are rejected in production.
# Example: ALLOWED_HOSTS=api.halqe.ir,clinic.halqe.ir
ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# CORS (optional in dev — defaults to localhost:3000)
# ---------------------------------------------------------------------------

# In production, set this to the actual front-end origin(s).
# Comma-separated. If unset in production, CORS is disabled (empty list).
# Example: CORS_ALLOWED_ORIGINS=https://app.halqe.ir,https://clinic.halqe.ir
# CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# POSTGRES SUPERUSER (apply_schema, conftest DDL, seed_demo — NOT the app)
# ---------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=55432
PG_DB=halqe_app
PG_USER=postgres
PG_PASSWORD=validate_only

# Test database name (used by conftest.py and pytest)
PG_TEST_DB=halqe_app_test

# ---------------------------------------------------------------------------
# POSTGRES APP ROLE (Django ORM connections — least-privilege)
# REQUIRED in production. In dev the defaults match the Docker test container.
# ---------------------------------------------------------------------------
PG_APP_USER=platform_login_test
PG_APP_PASSWORD=test_pw

# ---------------------------------------------------------------------------
# SCHEMA SLICE DIRECTORY
# ---------------------------------------------------------------------------
# Override when the schema slices are not at the default relative path
# (halqe/db/schema/, alongside this app).
# SCHEMA_SLICE_DIR=/absolute/path/to/schema

# ---------------------------------------------------------------------------
# SMS PROVIDER (Kavenegar) — DEFAULT-SAFE: NullProvider (simulation) unless
# you BOTH set a key AND flip SMS_LIVE_ENABLED. See halqe/docs/sms_go_live.md.
# ---------------------------------------------------------------------------
# Provider selector: 'kavenegar' (default) or 'null' (force simulation).
SMS_PROVIDER=kavenegar

# Live Kavenegar API key. NEVER commit a real key — set it only in .env (which
# is git-ignored). Leaving this blank keeps the system on NullProvider.
KAVENEGAR_API_KEY=

# Optional dedicated sender line. Blank → Kavenegar uses the account default.
KAVENEGAR_SENDER=

# Per-request HTTP timeout (seconds). Timeout → 'pending' (NOT failed); the
# message was most likely sent, so callers must not retry.
KAVENEGAR_TIMEOUT=45

# ⚠️ OWNER GATE — the SECOND, EXPLICIT live switch. MUST STAY false until the
# clinic owner completes Kavenegar KYC (the account returns code 430 / احراز
# هویت ناقص until then). A configured KAVENEGAR_API_KEY alone is NOT enough to
# send real SMS — this flag must also be truthy ('1'/'true'/'yes'/'on').
# Keep it false in dev/CI/tests, ALWAYS.
SMS_LIVE_ENABLED=false
